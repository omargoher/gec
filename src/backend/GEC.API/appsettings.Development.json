{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq", "Serilog.Expressions" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": {
            "type": "Serilog.Templates.ExpressionTemplate, Serilog.Expressions",
            "template": "[{@t:HH:mm:ss} {@l:u3}] {#if TraceId is not null}[TraceId:{TraceId}] {#end}{@m}\n{@x}"
          }
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://seq:80"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "pgsql": "Host=localhost;Port=5433;Database=GECDb;Username=GECDbUser;Password=123456"
  },
  "Cors": { 
    "AllowedOrigin": "https://localhost:3000"
  },
  "MailSettings": {
    "Host": "smtp.example.com",
    "Port": 587,
    "FromName": "Your App Name",
    "FromEmail": "system@yourdomain.com",
    "UserName": "your_username",
    "Password": "your_password"
  },
  "OtpSettings": {
    "PepperKey": "SUPER_SECRET_STRONG_PEPPER_KEY_CHANGE_IN_PRODUCTION_1234567890!",
    "Length": 6,
    "ExpiryInMinutes": 5,
    "MaxAttempts": 3
  },
  "TestSettings": {
    "TestConfig": "Some test config value"
  },
  "AdminCredentials": {
    "Name": "Admin User",
    "Email": "admin@example.com",
    "Password": "Admin@123"
  }
}
